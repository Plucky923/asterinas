+
+    /// Visit occupied storage slots once, starting at the given slot and wrapping.
+    pub(crate) fn items_mut_from(
+        &mut self,
+        start: usize,
+    ) -> impl Iterator<Item = (usize, &mut Item<'a>)> + '_ {
+        let start = if self.sockets.is_empty() {
+            0
+        } else {
+            start % self.sockets.len()
+        };
+        let (head, tail) = self.sockets.split_at_mut(start);
+        tail.iter_mut()
+            .enumerate()
+            .map(move |(index, slot)| (start + index, slot))
+            .chain(head.iter_mut().enumerate())
+            .filter_map(|(index, slot)| slot.inner.as_mut().map(|item| (index, item)))
+    }
